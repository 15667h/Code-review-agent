# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- WorkBuddy 本地项目数据（记忆 / 本地配置） ----
.workbuddy/

# harness HTTP 服务的运行归档（每次审计一份 JSON，属运行时数据）
backend/.runs/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/

# ---- 环境变量与密钥（禁止入库） ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# ---- 运行时产物 ----
*.log
logs/
tmp/
temp/
output/
outputs/
cache/
.cache/
*.sqlite
*.sqlite3
*.db
data/raw/

# ---- 报告 / 中间产物 ----
*.html.bak

# ---- 架构测试场：案例代码从上游克隆，不入库（brief.md / RESULTS.md 记录选题与结论，
#      repo/ 由 brief 里的 URL 自行克隆，避免把三个上游仓库整体搬进本项目）----
backend/arch-cases/*/repo/

# ---- 本机账号表：含密码哈希，绝不入库 ----
backend/.auth/
