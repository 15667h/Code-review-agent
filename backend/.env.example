# Margin Harness 的环境变量
#
# 复制为 .env 后填写。harness 不依赖 python-dotenv，
# 启动时由 harness.config 自己解析这个文件。
# .env 已被 gitignore，密钥不会进仓库。

# ---------- 模型：只需要这三项 ----------
# 走 OpenAI 兼容协议（/chat/completions）。DeepSeek、OpenAI、通义、Moonshot、
# 智谱、vLLM、Ollama、LM Studio、各类中转服务都支持，换服务只改这三个值。
#
# 接口地址：服务商给的根地址，通常以 /v1 结尾。
#   贴成完整请求地址（带 /chat/completions）也能识别，会自动裁掉。
LLM_BASE_URL=https://api.deepseek.com

# API Key：留空则只能跑 --offline（规则模式）。
#   自建服务的密钥可以是任意字符串，不要求 sk- 前缀。
LLM_API_KEY=

# 模型名称：必须是服务端确实提供的名字。不确定就启动服务后在配置中心点「探测」。
LLM_MODEL=deepseek-chat

# 旧变量名仍然有效（已经配好的 .env 不用改）：
# DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY / DEEPSEEK_MODEL

# ---------- 运行参数（都有默认值，通常不用改） ----------
# 单次审计的最大迭代轮数（硬约束，防止死循环）
AUDIT_MAX_ITERATIONS=40
# 上下文窗口，用于触发压缩（默认按 80% 触发）
AUDIT_CONTEXT_WINDOW=131072
# 连续同样工具调用 N 次即判定陷入循环
AUDIT_REPEAT_LIMIT=3
# 采样温度：审查任务建议 0.1–0.3
AUDIT_TEMPERATURE=0.2
# 单次请求超时（秒）
AUDIT_TIMEOUT=120

# ---------- 沙箱 ----------
# 允许 Agent 读写的根目录；留空则用 --repo 指定的仓库目录
AUDIT_WORKSPACE_ROOT=
# 允许执行的命令白名单（逗号分隔）
AUDIT_ALLOW_COMMANDS=python,pytest,lint,pyright,mypy,ruff,eslint,npm,node,go,git

# 访问控制：置 1 后未登录访问业务接口返回 401（前端自动跳登录页）。
# 默认不设：本机工具直开即用，登录态只用于「知道自己是谁」与退出。
# MARGIN_REQUIRE_AUTH=1
