{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Margin",
          "informationUri": "https://github.com/15667h/Code-review-agent",
          "rules": [
            {
              "id": "MARGIN001",
              "name": "MARGIN001",
              "shortDescription": {
                "text": "Margin 审查发现（未分类）"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "maintainability"
                ]
              }
            }
          ]
        }
      },
      "results": [],
      "columnKind": "utf16CodeUnits",
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "file://C:/Users/34442/Desktop/porject/代码审查agent/"
        }
      }
    }
  ]
}